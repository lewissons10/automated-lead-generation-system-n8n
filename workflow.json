      "name": "Hunter Email Search"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const emails = item.json.data?.emails || [];\n\n  let email = \"Not Found\";\n  let emailType = \"Not Found\";\n  let confidence = \"Not Found\";\n\n  if (emails.length > 0) {\n    const genericEmail = emails.find(e => e.type === \"generic\");\n    const selectedEmail = genericEmail || emails[0];\n\n    email = selectedEmail.value || \"Not Found\";\n    emailType = selectedEmail.type || \"Not Found\";\n    confidence = selectedEmail.confidence || \"Not Found\";\n  }\n\n  return {\n    json: {\n      company_email: email,\n      email_type: emailType,\n      email_confidence: confidence\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
