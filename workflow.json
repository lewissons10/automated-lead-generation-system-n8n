    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const html = typeof item.json === \"string\"\n    ? item.json\n    : JSON.stringify(item.json);\n\n  const phoneRegex = /(\\+?\\d[\\d\\s\\-().]{8,18})/g;\n  const matches = html.match(phoneRegex) || [];\n\n  let phone = \"Not Found\";\n\n  if (matches.length > 0) {\n    phone = matches[0].replace(/\\s+/g, \" \").trim();\n  }\n\n  return {\n    json: {\n      company_phone: phone\n    }\n  };\n});"
      },
