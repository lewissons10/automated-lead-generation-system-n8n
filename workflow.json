      ],
      "id": "2c768bd1-f7ea-4988-9524-b7bdf1ac4b2d",
      "name": "Filter Valid Leads"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let score = 0;\n\n  const text = `${item.json.company} ${item.json.description} ${item.json.industry_source}`.toLowerCase();\n\n  if (text.includes(\"school\")) score += 30;\n  if (text.includes(\"college\")) score += 30;\n  if (text.includes(\"university\")) score += 30;\n  if (text.includes(\"hospital\")) score += 30;\n  if (text.includes(\"clinic\")) score += 25;\n  if (text.includes(\"construction\")) score += 25;\n  if (text.includes(\"logistics\")) score += 25;\n  if (text.includes(\"transport\")) score += 25;\n\n  if (text.includes(\"admission\")) score += 20;\n  if (text.includes(\"registration\")) score += 20;\n  if (text.includes(\"application\")) score += 15;\n  if (text.includes(\"contact\")) score += 10;\n\n  let quality = \"Low\";\n  if (score >= 60) quality = \"High\";\n  else if (score >= 35) quality = \"Medium\";\n\n  return {\n    json: {\n      ...item.json,\n      lead_score: score,\n      lead_quality: quality\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
