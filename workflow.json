    {
      "parameters": {
        "jsCode": "const allResults = [];\n\nfor (const item of items) {\n  const results = item.json.organic_results || [];\n  const searchQuery = item.json.search_parameters?.q || item.json.query || \"Unknown\";\n\n  for (const result of results) {\n    allResults.push({\n      json: {\n        company: result.title || \"Unknown\",\n        website: result.link || \"\",\n        industry_source: searchQuery,\n        location: \"India\",\n        description: result.snippet || \"\",\n        source: \"SerpApi\"\n      }\n    });\n  }\n}\n\nreturn allResults;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "9df7f10d-884e-434d-994c-9402c81d4127",
      "name": "Clean Lead Data"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let website = item.json.website || \"\";\n\n  let domain = website\n    .replace(\"https://\", \"\")\n    .replace(\"http://\", \"\")\n    .replace(\"www.\", \"\")\n    .split(\"/\")[0]\n    .trim();\n\n  return {\n    json: {\n      ...item.json,\n      domain\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
